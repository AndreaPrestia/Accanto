# Esempio di configurazione per `scripts/smoke/s3-replica-smoke.ps1`.
# Copia in `.env.s3-replica` (gia' in .gitignore) e compila con i valori reali.
#
# Le chiavi seguono la convenzione di ASP.NET Core per il binding di
# `S3DocumentReplica:*` da variabili d'ambiente (doppio underscore).
#
# IMPORTANTE: il bucket dedicato ai documenti e' `accanto-docs`
# (separato da `accanto-backups` per due ragioni):
#  1. Blast radius: leak della key qui sotto NON espone i dump DB.
#  2. Policy bucket-level: `accanto-docs` ha Object Lock DISABLED
#     (compatibile GDPR art. 17 — il worker deve poter cancellare
#     tutte le versioni in cascade su erasure). `accanto-backups`
#     invece ha Object Lock ENABLED (immutabilita' dei dump).

S3DocumentReplica__Enabled=true
S3DocumentReplica__ServiceUrl=https://s3-eu-central-1.ionoscloud.com
S3DocumentReplica__Region=de
S3DocumentReplica__Bucket=accanto-docs
S3DocumentReplica__Prefix=documents/
S3DocumentReplica__AccessKeyId=
S3DocumentReplica__SecretAccessKey=
S3DocumentReplica__PollIntervalSeconds=10
S3DocumentReplica__BatchSize=10
S3DocumentReplica__MaxRetries=5

# Opzionale: override del path locale dove scrivere il file di smoke
# prima del PUT (default /data/storage da appsettings).
# Storage__RootPath=./storage
