---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { localeFromPath, type Locale, LOCALES, routeKeyFromPath, ROUTES } from '../i18n';

interface Props {
  title: string;
  description: string;
  /** Override OG image (path assoluto pubblico). Default: /og-default.svg */
  ogImage?: string;
}

const { title, description, ogImage = '/og-default.svg' } = Astro.props as Props;
const locale: Locale = localeFromPath(Astro.url.pathname);

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonical = `${siteUrl}${Astro.url.pathname}`;

// hreflang per la stessa rotta logica nelle altre lingue
const routeKey = routeKeyFromPath(Astro.url.pathname);
const alternates = LOCALES.map((loc) => {
  const slug = routeKey ? ROUTES[routeKey][loc] : '';
  const path = slug ? `/${loc}/${slug}` : `/${loc}`;
  return { hreflang: loc, href: `${siteUrl}${path}` };
});

const htmlLangMap: Record<Locale, string> = { it: 'it-IT', en: 'en-US', es: 'es-ES' };
---
<!doctype html>
<html lang={htmlLangMap[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#475569" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/it`} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:locale" content={htmlLangMap[locale]} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <!-- JSON-LD Organization (semplice, sostituibile) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'Accanto',
      url: siteUrl,
      description
    })} />

    <!-- Slot opzionale per analytics: per ora vuoto.
         Per Plausible self-hosted: aggiungere qui <script defer data-domain="..." src="..."></script>. -->

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header locale={locale} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
