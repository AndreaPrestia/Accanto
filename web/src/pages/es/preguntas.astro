---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqItem from '../../components/FaqItem.astro';
import { routeUrl } from '../../i18n';
import { getFaq, faqJsonLd } from '../../data/faq';

const lang = 'es' as const;
const entries = getFaq(lang);
---
<BaseLayout
  title="Preguntas frecuentes · Accanto"
  description="Respuestas a las preguntas más habituales sobre Accanto: para quién es, cómo funciona, privacidad, IA, self-hosting."
>
  <script type="application/ld+json" set:html={faqJsonLd(lang)} />

  <section class="container-page container-prose">
    <p class="eyebrow mb-3">FAQ</p>
    <h1>Preguntas frecuentes</h1>
    <p>Las respuestas a las preguntas más habituales. Si no encuentras la tuya, escríbenos desde la página de <a href={routeUrl('contact', lang)}>contacto</a>.</p>
  </section>

  <section class="container-page">
    <div class="mx-auto max-w-2xl space-y-3">
      {entries.map((e) => (
        <FaqItem question={e.question}>{e.answer}</FaqItem>
      ))}
    </div>
  </section>
</BaseLayout>
