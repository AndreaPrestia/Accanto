---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import { routeUrl } from '../../i18n';

const appUrl = import.meta.env.PUBLIC_APP_URL;
const lang = 'es' as const;

const features = [
  { title: 'Círculos de cuidado', description: 'Un círculo por persona cuidada: invitas a quien quieres y decides qué compartir.' },
  { title: 'Cronología compartida', description: 'Notas, síntomas y episodios en orden cronológico, accesibles al círculo.' },
  { title: 'Documentos', description: 'Recetas, informes y formularios, organizados y disponibles cuando hacen falta.' },
  { title: 'Preguntas para el médico', description: 'Recopila dudas y observaciones entre una visita y la siguiente.' },
  { title: 'Avisos a la familia', description: 'Un resumen cuando hace falta, sin chats interminables.' },
  { title: 'Cuidarte a ti', description: 'Espacios de reflexión para reconocer tu propia carga.' }
];
---
<BaseLayout
  title="Accanto · Habitación tranquila para familiares cuidadores"
  description="Accanto reúne información, documentos y avisos para quien cuida a un familiar. Self-hosted, privacy by design, IA opcional."
>
  <Hero
    eyebrow="Para familiares cuidadores"
    title="Una habitación tranquila para quien cuida a un familiar"
    subtitle="Información, documentos y avisos en un solo sitio. Invitas a quien quieres y decides qué compartir."
    ctaPrimary={{ label: 'Crea tu espacio', href: `${appUrl}/register` }}
    ctaSecondary={{ label: 'Ver funcionalidades', href: routeUrl('features', lang) }}
  />

  <section class="container-page">
    <h2 class="text-2xl font-semibold mb-2 text-center">Lo que cambia, en concreto</h2>
    <p class="text-accanto-600 text-center max-w-2xl mx-auto mb-10">Lo que más nos han contado quienes cuidan, en tres ideas.</p>
    <div class="grid gap-4 sm:grid-cols-3">
      <FeatureCard title="No más «ya lo recordaré yo»" description="La información en un único lugar, disponible también de noche o en urgencias." />
      <FeatureCard title="Familia alineada" description="Un círculo en el que los avisos llegan a quien hace falta, sin inundar chats." />
      <FeatureCard title="También espacio para ti" description="Recordatorios sobre tu bienestar: quien cuida también necesita cuidado." />
    </div>
  </section>

  <section class="container-page bg-white border-y border-accanto-100">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow mb-3">Funcionalidades principales</p>
      <h2 class="text-2xl font-semibold mb-6">Lo esencial, nada más</h2>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((f) => (
        <FeatureCard title={f.title} description={f.description} />
      ))}
    </div>
    <div class="text-center mt-8">
      <a href={routeUrl('features', lang)} class="btn-ghost">Ver todas las funcionalidades</a>
    </div>
  </section>

  <section class="container-page">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow mb-3">Confianza</p>
      <h2 class="text-2xl font-semibold mb-4">Tus datos son tuyos</h2>
      <p class="text-accanto-600 leading-relaxed">
        Accanto está pensado para poder instalarse incluso en tu propia casa. La inteligencia artificial es
        opcional, está desactivada por defecto y, cuando se activa, puede ejecutarse en un modelo self-hosted.
        Sin publicidad, sin perfilado, exportación completa de datos en cualquier momento.
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a href={routeUrl('privacy', lang)} class="btn-ghost">Cómo tratamos los datos</a>
        <a href={`${appUrl}/register`} class="btn-primary">Crea tu espacio</a>
        <a
          href="https://github.com/AndreaPrestia/Accanto/releases/latest"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost"
        >
          <span aria-hidden="true">↓ </span>Descargar para auto-alojar
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
