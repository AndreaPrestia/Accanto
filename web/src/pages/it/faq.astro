---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqItem from '../../components/FaqItem.astro';
import { routeUrl } from '../../i18n';
import { getFaq, faqJsonLd } from '../../data/faq';

const lang = 'it' as const;
const entries = getFaq(lang);
---
<BaseLayout
  title="Domande frequenti · Accanto"
  description="Risposte alle domande più comuni su Accanto: a chi serve, come funziona, privacy, AI, self-hosting."
>
  <script type="application/ld+json" set:html={faqJsonLd(lang)} />

  <section class="container-page container-prose">
    <p class="eyebrow mb-3">FAQ</p>
    <h1>Domande frequenti</h1>
    <p>Le risposte alle domande più frequenti. Se non trovi la tua, scrivici dalla pagina <a href={routeUrl('contact', lang)}>contatti</a>.</p>
  </section>

  <section class="container-page">
    <div class="mx-auto max-w-2xl space-y-3">
      {entries.map((e) => (
        <FaqItem question={e.question}>{e.answer}</FaqItem>
      ))}
    </div>
  </section>
</BaseLayout>
