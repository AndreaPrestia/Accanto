---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import { routeUrl } from '../../i18n';

const appUrl = import.meta.env.PUBLIC_APP_URL;
const lang = 'en' as const;

const groups = [
  {
    title: 'Organize',
    items: [
      { title: 'Care circles', description: 'A space per person you care for, with invites for family, carers and professionals.' },
      { title: 'Roles and permissions', description: 'Decide what each person can see or edit. Change your mind anytime.' },
      { title: 'Documents', description: 'Prescriptions, reports and forms, easy to find in seconds.' }
    ]
  },
  {
    title: 'Communicate',
    items: [
      { title: 'Timeline', description: 'Notes, symptoms and episodes on a single shared timeline.' },
      { title: 'Updates', description: 'A summary for the family, on demand, without endless chats.' },
      { title: 'Questions for the doctor', description: 'Gather doubts between visits, print them when needed.' }
    ]
  },
  {
    title: 'Care for yourself',
    items: [
      { title: 'Reflections', description: 'Private notes to acknowledge how you are today.' },
      { title: 'Reminders', description: 'Breaks, rest and useful contacts, surfaced at the right moment.' },
      { title: 'Local resources', description: 'Room for emergency contacts and local services.' }
    ]
  }
];
---
<BaseLayout
  title="Features · Accanto"
  description="Accanto features to organize, communicate and care for yourself: care circles, timeline, documents, family updates."
>
  <section class="container-page">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow mb-3">Features</p>
      <h1 class="text-3xl sm:text-4xl font-semibold mb-4">Tools to support a family member</h1>
      <p class="text-accanto-600 leading-relaxed">Organize, communicate, take care of yourself. Tools shaped with people who give care every day, no unnecessary steps.</p>
    </div>
  </section>

  {groups.map((g) => (
    <section class="container-page border-t border-accanto-100">
      <h2 class="text-2xl font-semibold mb-6 text-center">{g.title}</h2>
      <div class="grid gap-4 sm:grid-cols-3">
        {g.items.map((it) => (
          <FeatureCard title={it.title} description={it.description} />
        ))}
      </div>
    </section>
  ))}

  <section class="container-page border-t border-accanto-100 text-center">
    <h2 class="text-2xl font-semibold mb-3">And artificial intelligence?</h2>
    <p class="max-w-2xl mx-auto text-accanto-600 leading-relaxed">
      It's optional and off by default. When on, it can run on a self-hosted model: information about
      the person you care for never leaves your environment. Use it only if it helps.
    </p>
    <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
      <a href={routeUrl('privacy', lang)} class="btn-ghost">Privacy and data</a>
      <a href={`${appUrl}/register`} class="btn-primary">Create your space</a>
    </div>
  </section>
</BaseLayout>
