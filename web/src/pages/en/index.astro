---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import StoreBadges from '../../components/StoreBadges.astro';
import { routeUrl, useT } from '../../i18n';

const appUrl = import.meta.env.PUBLIC_APP_URL;
const lang = 'en' as const;
const t = useT(lang);

const features = [
  { title: 'Care circles', description: 'A circle per person you care for: invite who you want and decide what to share.' },
  { title: 'Shared timeline', description: 'Notes, symptoms and episodes in chronological order, accessible to the circle.' },
  { title: 'Documents', description: 'Prescriptions, reports and forms, organized and easy to find when needed.' },
  { title: 'Questions for the doctor', description: 'Collect doubts and observations between one visit and the next.' },
  { title: 'Family updates', description: 'A summary on demand, without endless chats.' },
  { title: 'Caring for yourself', description: 'Reflection spaces to acknowledge your own workload.' }
];
---
<BaseLayout
  title="Accanto · A quiet room for family caregivers"
  description="Accanto brings together information, documents and updates for those caring for a family member. Self-hosted, privacy by design, optional AI."
>
  <Hero
    eyebrow="For family caregivers"
    title="A quiet room for those caring for a family member"
    subtitle="Information, documents and updates in one place. You invite who you want and decide what to share."
    ctaPrimary={{ label: 'Create your space', href: `${appUrl}/register` }}
    ctaSecondary={{ label: 'See features', href: routeUrl('features', lang) }}
  />

  <section class="container-page">
    <h2 class="text-2xl font-semibold mb-2 text-center">What changes, concretely</h2>
    <p class="text-accanto-600 text-center max-w-2xl mx-auto mb-10">What family caregivers told us most often, in three ideas.</p>
    <div class="grid gap-4 sm:grid-cols-3">
      <FeatureCard title="No more «I'll remember it»" description="All the information in one place, available at night or in the ER." />
      <FeatureCard title="Family on the same page" description="A circle where updates reach the right people, without flooding chats." />
      <FeatureCard title="Room for you too" description="Reminders about your own wellbeing: caregivers need care too." />
    </div>
  </section>

  <section class="container-page bg-white border-y border-accanto-100">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow mb-3">Main features</p>
      <h2 class="text-2xl font-semibold mb-6">Just the essentials, nothing more</h2>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((f) => (
        <FeatureCard title={f.title} description={f.description} />
      ))}
    </div>
    <div class="text-center mt-8">
      <a href={routeUrl('features', lang)} class="btn-ghost">See all features</a>
    </div>
  </section>

  <StoreBadges
    title={t('mobile.title')}
    subtitle={t('mobile.subtitle')}
    comingSoonLabel={t('mobile.comingSoon')}
    iosLabel={t('mobile.ios')}
    androidLabel={t('mobile.android')}
  />

  <section class="container-page">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow mb-3">Trust</p>
      <h2 class="text-2xl font-semibold mb-4">Your data stays yours</h2>
      <p class="text-accanto-600 leading-relaxed">
        Accanto is built to be self-hosted, even at home. AI features are optional, off by default,
        and when on they can run on a self-hosted model. No ads, no profiling, full data export anytime.
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a href={routeUrl('privacy', lang)} class="btn-ghost">How we handle data</a>
        <a href={`${appUrl}/register`} class="btn-primary">Create your space</a>
        <a
          href="https://github.com/AndreaPrestia/Accanto/releases/latest"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost"
        >
          <span aria-hidden="true">↓ </span>Download to self-host
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
