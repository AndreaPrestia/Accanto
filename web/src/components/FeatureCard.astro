---
interface Props {
  title: string;
  description: string;
  icon?: string; // emoji o glifo testuale
}

const { title, description, icon } = Astro.props as Props;
---
<div class="card h-full">
  {icon && <div aria-hidden="true" class="text-2xl mb-2">{icon}</div>}
  <h3 class="text-base font-semibold text-accanto-900 mb-1">{title}</h3>
  <p class="text-sm text-accanto-600 leading-relaxed">{description}</p>
</div>
