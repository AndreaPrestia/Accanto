# Variabili di configurazione del sito vetrina.
# Copia in `.env` (non versionato) per override locali.

# URL canonico del sito vetrina (usato in OG/canonical/sitemap).
SITE_URL=https://accanto.example

# URL dell'applicazione SPA (usato dalle CTA "Accedi" / "Registrati").
PUBLIC_APP_URL=https://app.accanto.example
