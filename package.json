{
  "name": "accanto-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*",
    "frontend",
    "mobile"
  ],
  "scripts": {
    "build:frontend": "npm --workspace frontend run build",
    "dev:frontend": "npm --workspace frontend run dev",
    "build:shared": "npm --workspace @accanto/shared run build",
    "typecheck:shared": "npm --workspace @accanto/shared run typecheck"
  },
  "overrides": {
    "form-data": "^4.0.6",
    "axios": "^1.20.0",
    "shell-quote": "^1.12.0",
    "nanoid@3": "^3.3.18",
    "undici@6": "^6.28.1",
    "source-map-js": "^1.2.2",
    "compression": "^1.8.2",
    "postcss": "^8.5.23",
    "js-yaml@4": "^4.3.2",
    "brace-expansion@1": "^1.1.21",
    "brace-expansion@2": "^2.1.7",
    "brace-expansion@5": "^5.0.12"
  }
}
