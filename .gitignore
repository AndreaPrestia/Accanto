# OS
.DS_Store
Thumbs.db

# IDE
.vs/
# Escludiamo .vscode/ ma NON i task condivisi (pipeline screenshot store, ecc.).
# Serve de-escludere sia la cartella sia il file: git non ri-includes un file
# se la sua directory parent e' ignorata.
.vscode/*
!.vscode/tasks.json
.idea/
*.user
*.suo

# .NET
bin/
obj/
*.dll
*.pdb
*.cache
*.log
TestResults/
coverage*
.coverage*

# Node
node_modules/
dist/
.next/
.cache/
*.tsbuildinfo

# Vite
frontend/dist/
frontend/dev-dist/

# Env / secrets
.env
.env.*.local
.env.local

# Local file storage (user uploads)
storage/*
!storage/.gitkeep

# Docker
*.pid

# Playwright
frontend/test-results/
frontend/playwright-report/
frontend/.playwright/

# Security scans
zap-reports/

# Backup artifacts (mai committarli � sono cifrati ma anche solo grossi)
backups/
*.dump
*.dump.enc
*.dump.enc.sha256

# Forensic snapshots (contengono PII, mai committare)
forensic/
*.forensic.tar.gz
*.forensic.tar.gz.sha256

# Local offsite credentials
.env.backup-offsite
.env.s3-replica

# SBOM artifacts (generati in CI, mai committare - vivono come release asset)
sbom/
*.cdx.json
*.cdx.json.sha256

# Config Expo/EAS spuri generati nella ROOT del monorepo (la config vera
# vive in mobile/). Lanciare expo/eas SOLO da mobile/, mai dalla root.
/eas.json
/app.json

