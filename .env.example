# --- Database ---
POSTGRES_DB=accanto
POSTGRES_USER=accanto
POSTGRES_PASSWORD=change-me-in-local

# --- Backend ---
# Connection string used by the backend container to reach the db service.
ConnectionStrings__Postgres=Host=db;Port=5432;Database=accanto;Username=accanto;Password=change-me-in-local

# JWT — generate a strong random key for any non-dev environment.
Jwt__Issuer=accanto
Jwt__Audience=accanto
Jwt__Key=please-change-me-to-a-long-random-secret-at-least-32-chars
Jwt__ExpiryMinutes=480

# Local file storage (inside the backend container).
Storage__RootPath=/data/storage
Storage__MaxFileSizeBytes=20971520

# Cifratura a riposo (campi DB sensibili + blob su disco).
# OBBLIGATORIA. 32 byte casuali in base64. Genera con: openssl rand -base64 32
# ATTENZIONE: se perdi questa chiave, i dati cifrati non sono piu' recuperabili.
Encryption__MasterKey=

# CORS — comma-separated origins allowed to call the API.
Cors__AllowedOrigins=http://localhost:5173,http://localhost:8081

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# --- Frontend ---
# In compose il frontend serve dietro nginx che fa proxy a /api -> backend:8080.
# Lascia /api per il deploy Docker. Se sviluppi il frontend con `npm run dev`
# fuori dal compose, imposta VITE_API_BASE_URL=http://localhost:8080/api.
VITE_API_BASE_URL=/api
