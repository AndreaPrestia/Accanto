# --- Database ---
POSTGRES_DB=accanto
POSTGRES_USER=accanto
POSTGRES_PASSWORD=change-me-in-local

# --- Backend ---
# Connection string used by the backend container to reach the db service.
ConnectionStrings__Postgres=Host=db;Port=5432;Database=accanto;Username=accanto;Password=change-me-in-local

# JWT — generate a strong random key for any non-dev environment.
Jwt__Issuer=accanto
Jwt__Audience=accanto
Jwt__Key=please-change-me-to-a-long-random-secret-at-least-32-chars
Jwt__ExpiryMinutes=480

# Local file storage (inside the backend container).
Storage__RootPath=/data/storage
Storage__MaxFileSizeBytes=20971520

# Cifratura a riposo (campi DB sensibili + blob su disco).
# OBBLIGATORIA. 32 byte casuali in base64. Genera con: openssl rand -base64 32
# ATTENZIONE: se perdi questa chiave, i dati cifrati non sono piu' recuperabili.
Encryption__MasterKey=

# Notifiche push (Web Push / VAPID). Opzionali: se entrambe le chiavi mancano
# il backend espone l'app senza notifiche push (gli endpoint /api/push restano
# attivi ma nessuna notifica viene effettivamente inviata).
# Genera una coppia con: npx web-push generate-vapid-keys
Push__VapidPublicKey=
Push__VapidPrivateKey=
Push__VapidSubject=mailto:admin@accanto.local

# Notifiche email (SMTP). Opzionali: se Email__SmtpHost o Email__FromAddress
# sono vuoti il backend opera in modalita' no-op (gli endpoint per le preferenze
# rimangono attivi ma non viene inviata alcuna email).
Email__SmtpHost=
Email__SmtpPort=587
Email__Username=
Email__Password=
Email__UseStartTls=true
Email__FromAddress=
Email__FromName=Accanto

# CORS — comma-separated origins allowed to call the API.
Cors__AllowedOrigins=http://localhost:5173,http://localhost:8081

# Rate limiting (finestra fissa). Lasciare vuoti per usare i default: login 5/min,
# register 10/h, sensitive 10/min, invio inviti 20/h.
# RateLimit__Login__PermitLimit=5
# RateLimit__Login__Window=00:01:00
# RateLimit__Register__PermitLimit=10
# RateLimit__Register__Window=01:00:00
# RateLimit__Sensitive__PermitLimit=10
# RateLimit__Sensitive__Window=00:01:00
# RateLimit__InviteCreate__PermitLimit=20
# RateLimit__InviteCreate__Window=01:00:00

# Lockout dopo N tentativi di login falliti consecutivi (default: 5 tentativi,
# blocco di 15 minuti, finestra di 15 minuti per il conteggio dei consecutivi).
# Lockout__MaxFailedAttempts=5
# Lockout__LockoutMinutes=15
# Lockout__AttemptWindowMinutes=15

# 2FA TOTP. Issuer mostrato nelle app autenticatore (Google Authenticator, Aegis, 1Password...).
# ChallengeLifetimeMinutes: durata del token JWT temporaneo emesso dopo password ok
# e prima della verifica TOTP. RecoveryCodeCount: codici monouso generati all'attivazione.
# TwoFactor__Issuer=Accanto
# TwoFactor__ChallengeLifetimeMinutes=5
# TwoFactor__RecoveryCodeCount=10

# --- Modulo AI (opzionale, self-hosted via Ollama) ---
# Lascia Provider=none per disattivare completamente l'AI a livello di sistema.
# Per attivarla: avvia lo stack con `docker compose --profile ai up -d`, poi
# `docker compose exec ollama ollama pull llama3.2:3b`, infine imposta le 3 var qui sotto
# e ricrea il backend (`docker compose up -d backend`). Ogni cerchio resta comunque
# off di default: l'owner deve attivare il toggle "Assistente AI" dalle impostazioni.
Ai__Provider=none
# Ai__Provider=ollama
# Ai__Endpoint=http://ollama:11434
# Ai__Model=llama3.2:3b
# Ai__TimeoutSeconds=60
# Ai__MaxOutputTokens=512
# Ai__MaxOutputChars=2000
# Cache idempotency (input identici, stesso utente+cerchio+funzione).
# Ai__CacheTtlMinutes=60
# Self-check del modello sulla propria risposta. Su modelli 3B il reviewer blocca
# spesso risposte legittime: lasciare false. Abilitare solo con modelli 8B+.
# Ai__SelfCheckEnabled=false
# Rate limit dedicato al bucket "ai" (default 20 chiamate/h per utente).
# RateLimit__Ai__PermitLimit=20
# RateLimit__Ai__Window=01:00:00

# --- Logging / Monitoring ---
# Serilog stampa di default su stdout (JSON in produzione). Per spedire i log
# anche a Seq (UI di ricerca/aggregazione), avvia con `docker compose --profile
# observability up -d` e abilita:
# Logging__SeqUrl=http://seq:5341
# Logging__SeqApiKey=

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# --- Frontend ---
# In compose il frontend serve dietro nginx che fa proxy a /api -> backend:8080.
# Lascia /api per il deploy Docker. Se sviluppi il frontend con `npm run dev`
# fuori dal compose, imposta VITE_API_BASE_URL=http://localhost:8080/api.
VITE_API_BASE_URL=/api

# --- Sito vetrina (cartella web/) ---
# URL pubblico assoluto del sito vetrina (apex). Usato per canonical URL,
# OpenGraph, hreflang e sitemap. In locale lascia il default.
WEB_SITE_URL=http://localhost:4321
# URL pubblico assoluto della SPA. Le CTA "Accedi"/"Registrati" del sito
# vetrina puntano qui. In locale è il container frontend su 5173.
WEB_PUBLIC_APP_URL=http://localhost:5173

# --- Deploy con Caddy (docker-compose.prod.yml) ---
# Dominio apex che serve il sito vetrina (es. accanto.care).
# ACCANTO_DOMAIN=accanto.care
# Sottodominio che serve la SPA. Se omesso, calcolato come "app.${ACCANTO_DOMAIN}".
# ACCANTO_APP_DOMAIN=app.accanto.care
# Sottodominio che serve le API. Se omesso, calcolato come "api.${ACCANTO_DOMAIN}".
# ACCANTO_API_DOMAIN=api.accanto.care
# Email per Let's Encrypt.
# ACCANTO_TLS_EMAIL=admin@accanto.care
# Tag delle immagini GHCR da utilizzare in prod (es. v0.7.2). Default: latest.
# ACCANTO_VERSION=v0.7.2
