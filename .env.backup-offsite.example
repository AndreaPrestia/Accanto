# Template per upload backup offsite verso IONOS S3 (o altro S3-compatibile).
#
# 1. Copia in `.env.backup-offsite` (gia' in .gitignore — NON committare):
#       Copy-Item .env.backup-offsite.example .env.backup-offsite
# 2. Compila i valori sotto.
# 3. Lancia: ./scripts/db/backup-offsite.ps1
#
# Le credenziali sono lette via env dal container amazon/aws-cli: mai
# scritte sulla command line, mai loggate.

# --- IONOS S3 (Francoforte) -------------------------------------------------
# Endpoint regionali IONOS: https://docs.ionos.com/cloud/managed-services/s3/
# Esempi:
#   - de       (Francoforte)  -> https://s3-eu-central-1.ionoscloud.com
#   - eu-south (Logrono ES)   -> https://s3-eu-south-2.ionoscloud.com
S3_ENDPOINT_URL=https://s3-eu-central-1.ionoscloud.com
S3_REGION=de
S3_BUCKET=accanto-backups
# Prefisso/cartella logica dentro al bucket. I tre script usano prefissi
# diversi (vedi accanto-ops/backup-restore.md):
#   backups/daily/      <- backup-offsite.ps1 (default qui sotto)
#   backups/forensic/   <- forensic-snapshot.ps1 (hardcoded nello script)
#   storage/            <- storage-upload.ps1   (hardcoded nello script)
S3_PREFIX=backups/daily/

# Access key creata in IONOS DCD -> Storage -> S3 Object Storage -> Key Management.
# Permessi minimi consigliati:
#   - s3:PutObject, s3:GetObject, s3:ListBucket, s3:GetBucketLocation
#   - NO s3:DeleteObject (l'append-only e' garantito anche dall'Object Lock)
AWS_ACCESS_KEY_ID=PLACEHOLDER_REPLACE_ME
AWS_SECRET_ACCESS_KEY=PLACEHOLDER_REPLACE_ME

# --- Object Lock (anti-ransomware / WORM) -----------------------------------
# Il bucket deve avere ObjectLockEnabled=Enabled (abilitato ALLA CREAZIONE
# del bucket — non puo' essere aggiunto dopo). Versioning DEVE essere ON.
# La retention e' settata per-object al PUT (vedi backup-offsite.ps1).
#
# S3_OBJECT_LOCK_ENABLED  "true" (default) o "false" per disabilitare il lock
#                         (utile in dev/staging contro bucket senza lock).
# S3_OBJECT_LOCK_MODE     "GOVERNANCE" (default, ammette override admin con
#                         s3:BypassGovernanceRetention per GDPR erasure) o
#                         "COMPLIANCE" (irreversibile fino a scadenza —
#                         attenzione: blocca GDPR art. 17 sui backup).
# S3_OBJECT_LOCK_DAYS     giorni di retention. Default 2555 (7 anni,
#                         allineato a retention sanitaria/contabile).
S3_OBJECT_LOCK_ENABLED=true
S3_OBJECT_LOCK_MODE=GOVERNANCE
S3_OBJECT_LOCK_DAYS=2555

# --- Dead-man's switch (opt-in) ---------------------------------------------
# URL Healthchecks.io / UptimeRobot pingati dopo upload OK. Se manca il ping
# per N minuti il provider esterno alza alert: un cron fallito non passa
# inosservato. Lascia vuoto per disabilitare.
# HEARTBEAT_BACKUP_URL=https://hc-ping.com/<uuid-backup-daily>
# HEARTBEAT_STORAGE_URL=https://hc-ping.com/<uuid-storage-sync>

# --- AWS S3 (alternativa) ---------------------------------------------------
# Per AWS S3 standard lascia vuoto S3_ENDPOINT_URL e imposta una regione AWS:
#   S3_ENDPOINT_URL=
#   S3_REGION=eu-central-1
#   S3_BUCKET=accanto-backups-prod
#   AWS_ACCESS_KEY_ID=...
#   AWS_SECRET_ACCESS_KEY=...

# --- Backblaze B2 S3-compatible (alternativa) -------------------------------
# https://www.backblaze.com/docs/cloud-storage-s3-compatible-api
#   S3_ENDPOINT_URL=https://s3.eu-central-003.backblazeb2.com
#   S3_REGION=eu-central-003
#   S3_BUCKET=accanto-backups
