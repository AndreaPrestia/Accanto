{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Store screenshots: Android (capture)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/mobile/scripts/store-screenshots.ps1",
        "-Mode",
        "capture-android"
      ],
      "options": {
        "cwd": "${workspaceFolder}/mobile"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "detail": "Cattura le 5 schermate dall'emulatore Android attivo via adb (guidata, premi INVIO per schermata)."
    },
    {
      "label": "Store screenshots: iOS (compose canvas)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/mobile/scripts/store-screenshots.ps1",
        "-Mode",
        "compose-ios",
        "-RawIosDir",
        "${workspaceFolder}/mobile/store/screenshots/_raw/ios"
      ],
      "options": {
        "cwd": "${workspaceFolder}/mobile"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "detail": "Composizione canvas App Store (1320x2868 + 1284x2778) dai PNG raw in store/screenshots/_raw/ios (artifact del workflow store-screenshots)."
    },
    {
      "label": "Store screenshots: marketing frames (all locales)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "& '${workspaceFolder}/mobile/scripts/store-screenshots.ps1' -Mode frames -RawIosDir '${workspaceFolder}/mobile/store/screenshots/_raw/ios' -Locales @('it-IT','en-US','es-ES')"
      ],
      "options": {
        "cwd": "${workspaceFolder}/mobile"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "detail": "Compositore frame marketing (sfondo brand + titolo/sottotitolo + screenshot arrotondato) per tutte le locali in frames.config.json."
    },
    {
      "label": "Release iOS: build only (production)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/mobile/scripts/release-ios.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}/mobile"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "detail": "Controlli preliminari + eas build --platform ios --profile production (senza submit). Richiede conferma."
    },
    {
      "label": "Release iOS: build + submit to App Store",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/mobile/scripts/release-ios.ps1",
        "-Submit"
      ],
      "options": {
        "cwd": "${workspaceFolder}/mobile"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "detail": "Controlli preliminari + eas build --platform ios --profile production --auto-submit (invia ad App Store Connect). Richiede conferma."
    },
    {
      "label": "Release iOS: dry-run (checks only)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/mobile/scripts/release-ios.ps1",
        "-Submit",
        "-DryRun"
      ],
      "options": {
        "cwd": "${workspaceFolder}/mobile"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "detail": "Esegue solo i controlli preliminari e stampa il comando eas senza eseguirlo (nessuna build)."
    },
    {
      "label": "Release Android: build only (production .aab)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/mobile/scripts/release-android.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}/mobile"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "detail": "Controlli preliminari + eas build --platform android --profile production (.aab). Da caricare a mano in Play Console per il primo rilascio."
    },
    {
      "label": "Release Android: build + submit to Play",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/mobile/scripts/release-android.ps1",
        "-Submit"
      ],
      "options": {
        "cwd": "${workspaceFolder}/mobile"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "detail": "eas build --platform android --profile production --auto-submit. Richiede service account Play e primo upload manuale gia' avvenuto."
    },
    {
      "label": "Store assets Android: screenshots + feature graphic + icona",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "& '${workspaceFolder}/mobile/scripts/store-screenshots.ps1' -Mode compose-android -RawIosDir '${workspaceFolder}/mobile/store/screenshots/_raw/ios'; & '${workspaceFolder}/mobile/scripts/store-screenshots.ps1' -Mode feature-graphic -RawIosDir '${workspaceFolder}/mobile/store/screenshots/_raw/ios' -Locales @('it-IT','en-US','es-ES'); & '${workspaceFolder}/mobile/scripts/store-screenshots.ps1' -Mode icon-android -RawIosDir '${workspaceFolder}/mobile/store/screenshots/_raw/ios'"
      ],
      "options": {
        "cwd": "${workspaceFolder}/mobile"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "detail": "Genera tutti gli asset grafici Play (5 screenshot 1080x1920 + feature graphic 1024x500 IT/EN/ES + icona 512x512) dai raw iOS."
    },
    {
      "label": "Store screenshots: Maestro flow (Android emulator)",
      "type": "shell",
      "command": "maestro",
      "args": [
        "test",
        ".maestro/screenshots.yaml"
      ],
      "options": {
        "cwd": "${workspaceFolder}/mobile"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "detail": "Cattura automatica delle 5 schermate con Maestro sull'emulatore attivo (richiede MAESTRO_APP_ID/EMAIL/PASSWORD in env)."
    }
  ]
}
