{
	email {$ACCANTO_TLS_EMAIL}
	# Decommenta per testare contro lo staging di Let's Encrypt (evita rate-limit):
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory

	# Log strutturati JSON su stdout (catturati da `docker compose logs caddy`).
	log {
		output stdout
		format json
	}

	# Niente Server header in chiaro, niente versione di Caddy.
	servers {
		strict_sni_host
	}

	# TLS: solo 1.2 e 1.3 (Caddy default, esplicitato per documentazione e
	# per evitare regressioni se i default upstream cambiano).
	servers :443 {
		protocols h1 h2 h3
	}
}

# Header di sicurezza comuni a entrambi i siti.
# Nota: il CSP è definito separatamente per sito vetrina (statico, usa Google Fonts)
# e per SPA (talk only to /api self-origin) perché hanno bisogni diversi.
(security_headers) {
	header {
		# HSTS 2 anni + preload (eligibile per https://hstspreload.org).
		# ATTENZIONE: una volta nel preload list rimuoverlo richiede mesi.
		# Submit solo quando sei sicuro che HTTPS resti per sempre.
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-site"
		-Server
		-X-Powered-By
	}
}

# --- Sito vetrina (dominio apex) ---
# Statico Astro. Usa Google Fonts: CSP allow-list esplicito per fonts.googleapis/gstatic.
{$ACCANTO_DOMAIN} {
	encode zstd gzip
	import security_headers

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}

	# Root → default locale (302). Evita la pagina di meta-refresh generata
	# da Astro.redirect() in modalità statica. /it /en /es restano serviti
	# normalmente dal container web.
	redir / /it 302

	# Servito da nginx nel container web (Astro statico)
	reverse_proxy web:8080
}

# --- Applicazione (sottodominio app.) ---
# SPA React. Le chiamate API vanno su {$ACCANTO_API_DOMAIN} (cross-origin, CORS gestito dal backend).
# Connect-src include il dominio API per consentire fetch/XHR dalla SPA.
{$ACCANTO_APP_DOMAIN} {
	encode zstd gzip
	import security_headers

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://{$ACCANTO_API_DOMAIN}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; worker-src 'self' blob:"
	}

	# SPA servita da nginx nel container frontend. Nessun proxy verso il backend qui:
	# le chiamate API partono dal browser e vanno direttamente a https://{$ACCANTO_API_DOMAIN}.
	reverse_proxy frontend:8080
}

# --- API (sottodominio api.) ---
# Backend .NET esposto come API JSON pura. CORS gestito dal backend (Cors__AllowedOrigins).
# Path pubblico: https://api.accanto.care/auth/login → backend riceve /api/auth/login.
# Niente CSP (non serve HTML), gli header di sicurezza vengono da security_headers.
#
# Usiamo `route {}` (ordering esplicito) invece di `handle {}` perché un
# `handle` senza path matcher diventa un route senza filtro e nella JSON
# generata precede gli altri, catturando anche /health/* prima del check
# di specificità.
{$ACCANTO_API_DOMAIN} {
	encode zstd gzip
	import security_headers

	# Limite hard sul body: matcha lo Storage__MaxFileSizeBytes del backend
	# (20 MB) con un piccolo margine per overhead multipart. Difende il
	# proxy da upload abusivi prima ancora che arrivino al .NET.
	request_body {
		max_size 25MB
	}

	# === Rate-limit per-IP a livello edge ===
	#
	# Defense-in-depth: il backend ha gia' rate-limit applicativo per-utente
	# (5/min login, 10/h register, ecc., vedi RateLimitOptions.cs). Quello
	# applicativo non protegge da attacchi di credential stuffing distribuiti
	# su MOLTI utenti dalla STESSA macchina (l'attaccante prova una password
	# diversa per ogni email rubata dal data breach: ogni utente ha 1 solo
	# tentativo, quindi il limit per-user non scatta mai).
	#
	# Questo blocco aggiunge un cap per-IP che limita il TOTALE di tentativi
	# auth da un singolo IP, indipendentemente dall'username. Modulo:
	# github.com/mholt/caddy-ratelimit, sliding window. Storage: in-memory
	# (basta per single-node Caddy; per multi-node serve distributed).
	#
	# Headers in risposta quando l'IP supera la soglia: HTTP 429.
	#
	# Limiti scelti larghi per non bloccare utenti legittimi su NAT/proxy
	# condivisi (es. uffici, scuole), ma stretti abbastanza per spezzare
	# rate alto di credential-stuffing automatizzato.
	#
	# `route {}` forza l'esecuzione delle directive in source order: il
	# rate_limit matcha sul path PUBBLICO (`/auth/...`) prima che il
	# rewrite aggiunga il prefisso `/api`.
	route {
		@auth_login path /auth/login
		@auth_refresh path /auth/refresh
		@auth_register path /auth/register

		rate_limit @auth_login {
			zone login_per_ip {
				key {remote_host}
				events 30
				window 1m
			}
		}

		rate_limit @auth_refresh {
			zone refresh_per_ip {
				key {remote_host}
				events 60
				window 1m
			}
		}

		rate_limit @auth_register {
			zone register_per_ip {
				key {remote_host}
				events 5
				window 1h
			}
		}

		# /health e /health/* sono esposti dal backend SENZA il prefisso /api
		# (controllati da UptimeRobot/Healthchecks.io e dal HEALTHCHECK Docker).
		# Tutte le altre rotte vengono riscritte aggiungendo /api perché il
		# backend espone i controller sotto quel prefisso (route attribute).
		@notHealth {
			not path /health /health/*
		}
		rewrite @notHealth /api{uri}
		reverse_proxy backend:8080
	}
}
